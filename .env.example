# Copy this file to .env and fill in your own values. .env is gitignored.

# ---- Google Earth Engine (required) ----
# Your Earth Engine *Cloud project* ID, e.g. "ee-yourname" or "my-gee-project-123456".
# Register at https://code.earthengine.google.com/register  (free for research/non-commercial).
# This is read at runtime; it must never be hard-coded anywhere in the source.
GEE_PROJECT=

# ---- NASA Earthdata (optional, Phase 10: ICESat-2 ATL13 / SWOT via earthaccess) ----
# Register at https://urs.earthdata.nasa.gov/users/new
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=

# ---- Optional overrides ----
# Alternative path to the config file (default: config/config.yaml)
# HDM_CONFIG=
